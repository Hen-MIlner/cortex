/* ==========================================================================
   CORTEX — AI Operating System
   Shared design system & Page components
   ========================================================================== */

:root {
  --bg: #050810;
  --bg-panel: #0a1020;
  --bg-panel-2: #0d1526;
  --bg-elevated: #101a30;
  --border: rgba(255, 255, 255, 0.07);
  --border-soft: rgba(255, 255, 255, 0.04);
  --cyan: #2fb8ff;
  --cyan-bright: #6fd6ff;
  --cyan-dim: rgba(47, 184, 255, 0.15);
  --green: #35d68a;
  --amber: #f5a623;
  --purple: #8b7bff;
  --text: #eef2f8;
  --text-dim: #8d97ab;
  --text-faint: #5b6478;
  --radius: 14px;
  --radius-sm: 9px;
  --font-display: 'Space Grotesk', 'Inter', system-ui, sans-serif;
  --font-body: 'Inter', system-ui, -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', 'IBM Plex Mono', monospace;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
}

body {
  background-image:
    radial-gradient(circle at 15% 0%, rgba(47, 184, 255, 0.06), transparent 40%),
    radial-gradient(circle at 85% 100%, rgba(139, 123, 255, 0.05), transparent 45%);
  min-height: 100vh;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font-family: inherit;
  cursor: pointer;
}

/* ==========================================================================
   Page Shell Components (Non-dashboard pages)
   ========================================================================== */

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
}

.page-title {
  font-family: var(--font-display);
  font-size: 26px;
  font-weight: 600;
}

.page-sub {
  font-size: 13px;
  color: var(--text-faint);
  margin-top: 4px;
}

.empty-state {
  border: 1px dashed var(--border);
  border-radius: var(--radius);
  padding: 40px 24px;
  text-align: center;
  color: var(--text-faint);
  font-size: 14px;
}

.simple-panel {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px 22px;
  margin-bottom: 18px;
}

.btn-primary {
  background: var(--cyan);
  color: #04121e;
  border: none;
  padding: 10px 18px;
  border-radius: 10px;
  font-weight: 600;
  font-size: 13px;
}

.btn-secondary {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text);
  padding: 9px 16px;
  border-radius: 10px;
  font-size: 13px;
}

.input-row {
  display: flex;
  gap: 10px;
  margin-bottom: 14px;
}

.input-row input,
.input-row select,
.input-row textarea {
  flex: 1;
  background: var(--bg-panel-2);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 9px;
  padding: 10px 12px;
  font-size: 13px;
  font-family: inherit;
}

.list-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border-soft);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item input[type="checkbox"] {
  width: 16px;
  height: 16px;
  accent-color: var(--cyan);
}

.list-item .li-title {
  flex: 1;
  font-size: 14px;
}

.list-item.done .li-title {
  text-decoration: line-through;
  color: var(--text-faint);
}

.tag-pill {
  font-size: 11px;
  padding: 3px 9px;
  border-radius: 999px;
  background: rgba(47, 184, 255, 0.15);
  color: var(--cyan-bright);
}

/* ==========================================================================
   Layout Shell
   ========================================================================== */

.shell {
  display: grid;
  grid-template-columns: 260px 1fr;
  min-height: 100vh;
}

/* Sidebar */
.sidebar {
  background: linear-gradient(180deg, #060a14, #04070d);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  position: sticky;
  top: 0;
  height: 100vh;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 8px 28px 8px;
}

.brand-mark {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 30% 30%, rgba(47, 184, 255, 0.25), rgba(47, 184, 255, 0.02));
  border: 1px solid rgba(47, 184, 255, 0.35);
  flex-shrink: 0;
}

.brand-mark svg {
  width: 26px;
  height: 26px;
}

.brand-text {
  line-height: 1.1;
}

.brand-text .name {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 18px;
  letter-spacing: 3px;
  color: var(--text);
}

.brand-text .tag {
  font-size: 9px;
  letter-spacing: 1.6px;
  color: var(--text-faint);
  text-transform: uppercase;
  margin-top: 3px;
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 14px;
  border-radius: var(--radius-sm);
  color: var(--text-dim);
  font-size: 14px;
  font-weight: 500;
  transition: background .15s, color .15s;
}

.nav-item svg {
  width: 18px;
  height: 18px;
  opacity: .85;
  flex-shrink: 0;
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.03);
  color: var(--text);
}

.nav-item.active {
  background: linear-gradient(90deg, rgba(47, 184, 255, 0.16), rgba(47, 184, 255, 0.02));
  color: #fff;
  border: 1px solid rgba(47, 184, 255, 0.25);
}

.sidebar-footer {
  margin-top: auto;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  background: rgba(255, 255, 255, 0.02);
  margin-top: 14px;
}

.avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--cyan), var(--purple));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: #04070d;
  flex-shrink: 0;
}

.user-meta {
  line-height: 1.25;
}

.user-meta .uname {
  font-size: 13px;
  font-weight: 600;
}

.user-meta .ustatus {
  font-size: 11px;
  color: var(--green);
  display: flex;
  align-items: center;
  gap: 5px;
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--green);
  display: inline-block;
  box-shadow: 0 0 6px var(--green);
}

.chev {
  margin-left: auto;
  opacity: .5;
}

.status-card {
  margin-top: 12px;
  padding: 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  background: rgba(255, 255, 255, 0.02);
  font-size: 11px;
}

.status-card .label {
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--text-faint);
  font-size: 10px;
  margin-bottom: 6px;
}

.status-card .val {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--green);
  font-weight: 600;
}

.status-card .sub {
  color: var(--text-faint);
  margin-top: 2px;
}

.icon-row {
  display: flex;
  justify-content: space-between;
  margin-top: 14px;
  padding: 0 6px;
}

.icon-btn {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-faint);
  border: 1px solid transparent;
}

.icon-btn:hover {
  background: rgba(255, 255, 255, 0.04);
  color: var(--text);
}

.icon-btn svg {
  width: 16px;
  height: 16px;
}

/* ==========================================================================
   Main Content Area
   ========================================================================== */

.main {
  padding: 22px 28px 40px;
  min-width: 0;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-bottom: 26px;
}

.topbar .time {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.time-row {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
  font-size: 15px;
}

.time-row svg {
  width: 15px;
  height: 15px;
  opacity: .6;
}

.date-row {
  font-size: 12px;
  color: var(--text-faint);
}

.voice-wave {
  display: flex;
  align-items: center;
  gap: 2px;
  margin-left: 6px;
}

.voice-wave span {
  width: 3px;
  background: var(--cyan);
  border-radius: 2px;
  display: inline-block;
  animation: wave 1.2s ease-in-out infinite;
}

.voice-wave span:nth-child(1) { height: 8px; animation-delay: 0s; }
.voice-wave span:nth-child(2) { height: 16px; animation-delay: .15s; }
.voice-wave span:nth-child(3) { height: 10px; animation-delay: .3s; }
.voice-wave span:nth-child(4) { height: 18px; animation-delay: .45s; }
.voice-wave span:nth-child(5) { height: 7px; animation-delay: .6s; }

@keyframes wave {
  0%, 100% { transform: scaleY(0.4); }
  50% { transform: scaleY(1); }
}

.search-bar {
  flex: 1;
  max-width: 420px;
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 10px 16px;
  color: var(--text-faint);
  font-size: 13px;
}
