/* ==========================================================================
   CORTEX — AI Operating System
   Shared design system
   ========================================================================== */

:root{
  --bg: #050810;
  --bg-panel: #0a1020;
  --bg-panel-2: #0d1526;
  --bg-elevated: #101a30;
  --border: rgba(255,255,255,0.07);
  --border-soft: rgba(255,255,255,0.04);
  --cyan: #2fb8ff;
  --cyan-bright: #6fd6ff;
  --cyan-dim: rgba(47,184,255,0.15);
  --green: #35d68a;
  --amber: #f5a623;
  --purple: #8b7bff;
  --text: #eef2f8;
  --text-dim: #8d97ab;
  --text-faint: #5b6478;
  --radius: 14px;
  --radius-sm: 9px;
  --font-display: 'Space Grotesk', 'Inter', system-ui, sans-serif;
  --font-body: 'Inter', system-ui, -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', 'IBM Plex Mono', monospace;
}

*{ box-sizing: border-box; }
html,body{
  margin:0; padding:0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
}

body{
  background-image:
    radial-gradient(circle at 15% 0%, rgba(47,184,255,0.06), transparent 40%),
    radial-gradient(circle at 85% 100%, rgba(139,123,255,0.05), transparent 45%);
  min-height: 100vh;
}

a{ color: inherit; text-decoration:none; }
button{ font-family: inherit; cursor: pointer; }

/* Layout shell */
.shell{
  display: grid;
  grid-template-columns: 260px 1fr;
  min-height: 100vh;
}

/* Sidebar */
.sidebar{
  background: linear-gradient(180deg, #060a14, #04070d);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  padding: 24px 16px;
  position: sticky;
  top: 0;
  height: 100vh;
}

.brand{
  display:flex; align-items:center; gap:12px;
  padding: 8px 8px 28px 8px;
}
.brand-mark{
  width:44px; height:44px;
  border-radius: 12px;
  display:flex; align-items:center; justify-content:center;
  background: radial-gradient(circle at 30% 30%, rgba(47,184,255,0.25), rgba(47,184,255,0.02));
  border: 1px solid rgba(47,184,255,0.35);
  flex-shrink:0;
}
.brand-mark svg{ width:26px; height:26px; }
.brand-text{ line-height:1.1; }
.brand-text .name{
  font-family: var(--font-display);
  font-weight:600;
  font-size: 18px;
  letter-spacing: 3px;
  color: var(--text);
}
.brand-text .tag{
  font-size: 9px;
  letter-spacing: 1.6px;
  color: var(--text-faint);
  text-transform: uppercase;
  margin-top: 3px;
}

.nav{ display:flex; flex-direction:column; gap:4px; flex:1; }
.nav-item{
  display:flex; align-items:center; gap:12px;
  padding: 11px 14px;
  border-radius: var(--radius-sm);
  color: var(--text-dim);
  font-size: 14px;
  font-weight: 500;
  transition: background .15s, color .15s;
}
.nav-item svg{ width:18px; height:18px; opacity:.85; flex-shrink:0; }
.nav-item:hover{ background: rgba(255,255,255,0.03); color: var(--text); }
.nav-item.active{
  background: linear-gradient(90deg, rgba(47,184,255,0.16), rgba(47,184,255,0.02));
  color: #fff;
  border: 1px solid rgba(47,184,255,0.25);
}

.sidebar-footer{ margin-top: auto; }

.user-card{
  display:flex; align-items:center; gap:10px;
  padding: 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.02);
  margin-top: 14px;
}
.avatar{
  width:34px; height:34px; border-radius:50%;
  background: linear-gradient(135deg, var(--cyan), var(--purple));
  display:flex; align-items:center; justify-content:center;
  font-size:12px; font-weight:700; color:#04070d;
  flex-shrink:0;
}
.user-meta{ line-height:1.25; }
.user-meta .uname{ font-size:13px; font-weight:600; }
.user-meta .ustatus{ font-size:11px; color: var(--green); display:flex; align-items:center; gap:5px; }
.dot{ width:6px; height:6px; border-radius:50%; background: var(--green); display:inline-block; box-shadow: 0 0 6px var(--green); }
.chev{ margin-left:auto; opacity:.5; }

.status-card{
  margin-top: 12px;
  padding: 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.02);
  font-size: 11px;
}
.status-card .label{ text-transform:uppercase; letter-spacing:1px; color: var(--text-faint); font-size:10px; margin-bottom:6px; }
.status-card .val{ display:flex; align-items:center; gap:6px; color: var(--green); font-weight:600; }
.status-card .sub{ color: var(--text-faint); margin-top:2px; }

.icon-row{
  display:flex; justify-content:space-between;
  margin-top:14px; padding: 0 6px;
}
.icon-btn{
  width:32px;height:32px;border-radius:8px;
  display:flex;align-items:center;justify-content:center;
  color: var(--text-faint);
  border: 1px solid transparent;
}
.icon-btn:hover{ background: rgba(255,255,255,0.04); color: var(--text); }
.icon-btn svg{ width:16px; height:16px; }

/* Main area */
.main{
  padding: 22px 28px 40px;
  min-width: 0;
}

.topbar{
  display:flex; align-items:center; gap:18px;
  margin-bottom: 26px;
}
.topbar .time{ display:flex; flex-direction:column; gap:2px; }
.time-row{ display:flex; align-items:center; gap:8px; font-weight:600; font-size:15px; }
.time-row svg{ width:15px; height:15px; opacity:.6; }
.date-row{ font-size:12px; color: var(--text-faint); }

.voice-wave{ display:flex; align-items:center; gap:2px; margin-left: 6px; }
.voice-wave span{
  width:3px; background: var(--cyan); border-radius:2px; display:inline-block;
  animation: wave 1.2s ease-in-out infinite;
}
.voice-wave span:nth-child(1){height:8px; animation-delay:0s;}
.voice-wave span:nth-child(2){height:16px; animation-delay:.15s;}
.voice-wave span:nth-child(3){height:10px; animation-delay:.3s;}
.voice-wave span:nth-child(4){height:18px; animation-delay:.45s;}
.voice-wave span:nth-child(5){height:7px; animation-delay:.6s;}
@keyframes wave{ 0%,100%{ transform: scaleY(0.4); } 50%{ transform: scaleY(1); } }

.search-bar{
  flex:1; max-width: 420px; margin-left:auto;
  display:flex; align-items:center; gap:10px;
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 10px 16px;
  color: var(--text-faint);
  font-size: 13px;
}
.search-bar svg{ width:15px; height:15px; opacity:.6; flex-shrink:0; }
.search-bar input{
  flex:1; background:none; border:none; color:var(--text); font-size:13px; outline:none;
  font-family: inherit;
}
.search-bar input::placeholder{ color: var(--text-faint); }
kbd{
  font-size: 10px; color: var(--text-faint);
  border: 1px solid var(--border); border-radius:5px; padding: 2px 6px;
  font-family: var(--font-mono);
}
.mic-btn{
  width:38px; height:38px; border-radius:50%;
  background: var(--bg-panel);
  border: 1px solid var(--border);
  display:flex; align-items:center; justify-content:center;
  color: var(--text-dim); flex-shrink:0;
}
.mic-btn svg{ width:16px; height:16px; }

/* Content grid */
.content-grid{
  display:grid;
  grid-template-columns: 1fr 320px;
  gap: 22px;
  align-items:start;
}

.col-main{ display:flex; flex-direction:column; gap:22px; min-width:0; }
.col-side{ display:flex; flex-direction:column; gap:16px; }

/* Hero */
.hero{
  position: relative;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  background: radial-gradient(circle at 50% 0%, rgba(47,184,255,0.08), transparent 60%), var(--bg-panel);
  padding: 30px 34px 34px;
  overflow: hidden;
}
.hero-top{
  display:flex; justify-content:space-between; align-items:flex-start; gap: 24px;
}
.greeting{ font-size:14px; color: var(--text-dim); margin:0 0 6px; }
.hero-name{
  font-family: var(--font-display);
  font-size: 40px; font-weight: 600; margin:0;
  color: var(--text);
}
.hero-name .dot-accent{ color: var(--cyan); }
.hero-sub{ font-size:14px; color: var(--text-dim); margin-top:6px; }

.hero-mark{
  text-align:center; flex-shrink:0;
  padding-top: 4px;
}
.hero-mark .wordmark{
  font-family: var(--font-display);
  font-size: 26px; letter-spacing: 10px; font-weight:600;
  color: var(--text);
}
.hero-mark .caption{ font-size:11px; color: var(--text-faint); letter-spacing:.5px; margin-top:4px; }

.brain-orb{
  display:flex; justify-content:center; margin: 18px 0 6px;
}
.brain-orb svg{ width: 220px; height: 140px; }

.ask-bar{
  display:flex; align-items:center; gap:12px;
  margin-top: 20px;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(47,184,255,0.25);
  border-radius: 14px;
  padding: 14px 18px;
}
.ask-bar input{
  flex:1; background:none; border:none; outline:none;
  color: var(--text); font-size: 14px; font-family: inherit;
}
.ask-bar input::placeholder{ color: var(--text-faint); }
.ask-mic{ color: var(--text-faint); display:flex; }
.ask-mic svg{ width:17px; height:17px; }
.ask-send{
  width:34px; height:34px; border-radius:50%;
  background: var(--cyan); border:none;
  display:flex; align-items:center; justify-content:center;
  box-shadow: 0 0 16px rgba(47,184,255,0.5);
}
.ask-send svg{ width:15px; height:15px; color:#04121e; }

/* quick action row */
.quick-row{
  display:grid; grid-template-columns: repeat(5, 1fr); gap:12px;
  margin-top: 18px;
}
.qa-card{
  display:flex; align-items:center; gap:10px;
  background: var(--bg-panel-2);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
  transition: border-color .15s, transform .15s;
}
.qa-card:hover{ border-color: rgba(47,184,255,0.4); transform: translateY(-1px); }
.qa-icon{
  width:34px; height:34px; border-radius:9px;
  display:flex; align-items:center; justify-content:center;
  background: rgba(47,184,255,0.12);
  flex-shrink:0;
}
.qa-icon svg{ width:16px; height:16px; color: var(--cyan-bright); }
.qa-title{ font-size:13px; font-weight:600; line-height:1.2; }
.qa-sub{ font-size:11px; color: var(--text-faint); margin-top:1px; }

/* overview */
.section-label{
  display:flex; align-items:center; gap:8px;
  font-size: 11px; letter-spacing: 1.2px; text-transform: uppercase;
  color: var(--text-faint); font-weight:600;
  margin-bottom: 12px;
}
.section-label .dot{ width:6px;height:6px; background:var(--cyan); box-shadow:0 0 6px var(--cyan); }

.stat-grid{
  display:grid; grid-template-columns: repeat(4, 1fr); gap:14px;
}
.stat-card{
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px 18px;
}
.stat-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; }
.stat-head .stat-label{ font-size:13px; color: var(--text-dim); font-weight:500; }
.stat-badge{
  width:28px; height:28px; border-radius:8px;
  display:flex; align-items:center; justify-content:center;
}
.stat-badge svg{ width:14px; height:14px; }
.stat-value{ font-size: 30px; font-weight:700; font-family: var(--font-display); }
.stat-foot{ font-size:12px; color: var(--text-faint); margin-top:4px; }
.spark{ height:26px; margin-top:10px; }

/* panels: activity / schedule */
.panel-row{
  display:grid; grid-template-columns: 1fr 1fr; gap:18px;
}
.panel{
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px 20px;
}
.panel-head{
  display:flex; justify-content:space-between; align-items:center;
  font-size:11px; letter-spacing:1.2px; text-transform:uppercase;
  color: var(--text-faint); font-weight:600;
  margin-bottom: 14px;
}
.panel-head svg{ width:14px; height:14px; opacity:.6; }

.activity-item{
  display:flex; align-items:center; gap:12px;
  padding: 10px 0;
  border-bottom: 1px solid var(--border-soft);
  font-size: 13px;
}
.activity-item:last-child{ border-bottom:none; padding-bottom:0; }
.activity-icon{
  width:28px;height:28px;border-radius:8px;
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;
}
.activity-icon svg{ width:14px; height:14px; }
.activity-text{ flex:1; color: var(--text); }
.activity-time{ font-size:11px; color: var(--text-faint); flex-shrink:0; }

.schedule-item{
  display:flex; align-items:flex-start; gap:12px;
  padding: 9px 0;
  font-size: 13px;
}
.sched-dot{ width:8px;height:8px; border-radius:50%; margin-top:5px; flex-shrink:0; }
.sched-time{ width:70px; color: var(--text-faint); font-size:12px; flex-shrink:0; }
.sched-title{ color: var(--text); }
.view-schedule{
  display:block; text-align:center;
  margin-top: 10px; padding-top: 12px;
  border-top: 1px solid var(--border-soft);
  font-size: 13px; color: var(--cyan-bright); font-weight:500;
}

/* Right column cards */
.side-card{
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px 18px;
}
.side-card-head{
  display:flex; justify-content:space-between; align-items:center;
  font-size: 11px; letter-spacing:1.2px; text-transform:uppercase;
  color: var(--text-faint); font-weight:600; margin-bottom: 12px;
}
.memory-viz{
  height: 130px; border-radius: 10px; overflow:hidden; margin-bottom: 12px;
  background: radial-gradient(circle at 50% 50%, rgba(47,184,255,0.12), transparent 70%);
  border: 1px solid var(--border-soft);
}
.memory-viz svg{ width:100%; height:100%; }
.memory-note{ font-size:13px; color: var(--text); }
.memory-note .sub{ font-size:12px; color: var(--text-faint); margin-top:2px; }

.quick-link{
  display:flex; align-items:center; gap:10px;
  padding: 9px 4px;
  font-size: 13px;
  border-bottom: 1px solid var(--border-soft);
}
.quick-link:last-child{ border-bottom:none; }
.ql-icon{
  width:30px;height:30px;border-radius:8px;
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;
}
.ql-icon svg{ width:14px;height:14px; }
.ql-title{ font-weight:600; }
.ql-sub{ font-size:11px; color: var(--text-faint); }
.ql-arrow{ margin-left:auto; opacity:.4; }

.insight-row{
  display:flex; align-items:center; gap:10px;
  padding: 8px 0;
  font-size: 13px;
  border-bottom: 1px solid var(--border-soft);
}
.insight-row:last-child{ border-bottom:none; }
.insight-row svg{ width:15px;height:15px; color: var(--text-faint); flex-shrink:0; }
.insight-row .ir-label{ flex:1; color: var(--text-dim); }
.ring{
  width:44px;height:44px; margin-left:auto;
}
.insight-val{ font-size:12px; font-weight:600; color: var(--green); margin-left:auto; display:flex; align-items:center; gap:5px;}

.voice-card{
  background: linear-gradient(160deg, rgba(47,184,255,0.1), var(--bg-panel));
}
.voice-viz{ height: 46px; margin: 8px 0 10px; }
.voice-status-text{ font-size:13px; font-weight:600; }
.voice-status-sub{ font-size:12px; color: var(--text-faint); margin-top:2px; }
.voice-status-sub b{ color: var(--cyan-bright); font-weight:600; }

/* Footer quote */
.footer-bar{
  margin-top: 26px;
  padding-top: 18px;
  border-top: 1px solid var(--border);
  display:flex; justify-content:center; align-items:center;
  gap: 10px;
  font-size: 13px; color: var(--text-faint); font-style: italic;
  position: relative;
}
.footer-bar .attrib{ color: var(--cyan-bright); font-style: normal; font-weight:600; }
.corner-orb{
  position: absolute; right: 0; bottom: -10px;
  width: 60px; height:60px; opacity:.7;
}

/* responsive */
@media (max-width: 1200px){
  .content-grid{ grid-template-columns: 1fr; }
  .quick-row{ grid-template-columns: repeat(3,1fr); }
  .stat-grid{ grid-template-columns: repeat(2,1fr); }
  .panel-row{ grid-template-columns: 1fr; }
}
@media (max-width: 860px){
  .shell{ grid-template-columns: 1fr; }
  .sidebar{ display:none; }
  .quick-row{ grid-template-columns: repeat(2,1fr); }
  .hero-top{ flex-direction:column; align-items:flex-start; }
}
